# ==============================================================================
# Akij Group - Central IT Asset Governance & Audit Portal
# Remote Server Production Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the values below with your server domain, IP, and secure passwords.
# 3. Generate a strong SECRET_KEY with:
#    openssl rand -hex 32
# ==============================================================================

# Core Django Environment
APP_ENV=production
DJANGO_DEBUG=0

# Secret Key (Must be unique and kept private in production)
# Generate via: openssl rand -hex 32
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production

# Allowed Hosts (Comma separated domain names and/or server public IP)
# Example: audit.akij.net,192.168.1.100,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip-or-domain.com

# CSRF Trusted Origins (Full URL with protocol: http:// or https://)
# Example: https://audit.akij.net,http://192.168.1.100:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-server-ip-or-domain.com

# SSL / HTTPS Enforcement (Set to 1 once SSL certificate is active, 0 for plain HTTP or testing)
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
AUDIT_DB_NAME=ag_audit
AUDIT_DB_USER=ag_audit
AUDIT_DB_PASSWORD=change-this-to-a-strong-postgres-password-123456
AUDIT_DB_CONN_MAX_AGE=60

# ==============================================================================
# Port Configuration
# ==============================================================================
# Direct Web application port (exposed on host)
WEB_PORT=8000

# Optional Nginx ports (if running with --profile with-nginx)
HTTP_PORT=80
HTTPS_PORT=443

# ==============================================================================
# Gunicorn Web Server Settings
# ==============================================================================
# Recommended workers = (2 x CPU cores) + 1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ==============================================================================
# SMTP Email Settings (Optional - for notifications)
# ==============================================================================
AUDIT_EMAIL_HOST=smtp.gmail.com
AUDIT_EMAIL_PORT=587
AUDIT_EMAIL_HOST_USER=
AUDIT_EMAIL_HOST_PASSWORD=
AUDIT_EMAIL_USE_TLS=1
AUDIT_FROM_EMAIL=audit-noreply@akij.net
