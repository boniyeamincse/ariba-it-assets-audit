# ==============================================================================
# Akij Group - Central IT Asset Governance & Audit Portal
# Remote Server Production Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# This file is automatically configured by ./deploy.sh on first run.
# You can also edit it manually to set custom domains or credentials.
# ==============================================================================

# Core Django Environment
APP_ENV=production
DJANGO_DEBUG=0

# Secret Key (Automatically generated by ./deploy.sh)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production

# Allowed Hosts (Comma separated domain names and/or server public IP)
# Automatically populated with detected server IP by ./deploy.sh
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (Full URL with protocol: http:// or https://)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SSL / HTTPS Enforcement (Set to 1 once SSL certificate is active, 0 for plain HTTP)
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
AUDIT_DB_NAME=ag_audit
AUDIT_DB_USER=ag_audit
AUDIT_DB_PASSWORD=change-this-to-a-strong-postgres-password-123456
AUDIT_DB_CONN_MAX_AGE=60

# ==============================================================================
# Initial Super Admin User Provisioning
# ==============================================================================
# ./deploy.sh automatically creates this super admin account on first run
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@akij.net
ADMIN_PASSWORD=change-this-to-admin-password-or-let-deploy-generate

# ==============================================================================
# Port Configuration
# ==============================================================================
WEB_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# ==============================================================================
# Gunicorn Web Server Settings
# ==============================================================================
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ==============================================================================
# SMTP Email Settings (Optional)
# ==============================================================================
AUDIT_EMAIL_HOST=smtp.gmail.com
AUDIT_EMAIL_PORT=587
AUDIT_EMAIL_HOST_USER=
AUDIT_EMAIL_HOST_PASSWORD=
AUDIT_EMAIL_USE_TLS=1
AUDIT_FROM_EMAIL=audit-noreply@akij.net
