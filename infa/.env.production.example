# Copy to the repository root as .env.production; never commit the real file.
APP_ENV=production
DJANGO_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=audit.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://audit.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0

AUDIT_DB_ENGINE=postgresql
AUDIT_DB_NAME=ag_audit
AUDIT_DB_USER=ag_audit
AUDIT_DB_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
AUDIT_DB_CONN_MAX_AGE=60

AUDIT_EMAIL_HOST=localhost
AUDIT_EMAIL_PORT=25
AUDIT_EMAIL_HOST_USER=
AUDIT_EMAIL_HOST_PASSWORD=
AUDIT_EMAIL_USE_TLS=0
AUDIT_FROM_EMAIL=audit@example.com

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
